# ПРАВО-СМОЛ — React SPA на pravo-smol.ru

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # несуществующие пути отдаём через index.html — роутер разруливает сам
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# кэширование статики (json — минута, чтобы новости появлялись сразу)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 1 minute"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# сжатие текстовых ресурсов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
